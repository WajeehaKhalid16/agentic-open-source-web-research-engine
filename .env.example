# Application Configuration
APP_NAME=Agentic Web Research Engine
APP_ENV=development
DATABASE_PATH=research.db

# Search Provider Configuration (Free DuckDuckGo by default, no Docker needed)
SEARCH_PROVIDER=duckduckgo
DUCKDUCKGO_URL=https://html.duckduckgo.com/html/
SEARXNG_URL=http://localhost:8080

REQUEST_TIMEOUT=15
MAX_SOURCES=10
MAX_SEARCH_ROUNDS=2

# Local Model (Ollama) Settings (Optional - automatic extractive fallback if offline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Crawling & Network Policy
USER_AGENT=AgenticWebResearchBot/0.1 (+https://github.com/example/agentic-web-research-engine)
MAX_CONTENT_SIZE_BYTES=2097152
SAFE_CRAWL_DELAY_SECONDS=0.5
